@model Client
@{ ViewData["Title"] = "Create Client"; }
<h1>Create Client</h1>
<form asp-action="Create" method="post" class="form">
    <div asp-validation-summary="ModelOnly" class="error"></div>
    <label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name" class="error"></span>
    <label asp-for="ContactDetails"></label><input asp-for="ContactDetails" placeholder="Email / phone / contact person" /><span asp-validation-for="ContactDetails" class="error"></span>
    <label asp-for="Region"></label><input asp-for="Region" placeholder="e.g. Southern Africa" /><span asp-validation-for="Region" class="error"></span>
    <button class="btn" type="submit">Save Client</button> <a asp-action="Index">Cancel</a>
</form>
